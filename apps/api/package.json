{
  "name": "@copy-trade/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node --env-file-if-exists=../../.env dist/main.mjs",
    "build": "tsdown",
    "migrate": "tsx --env-file-if-exists=../../.env src/jobs/migrate.ts",
    "reconcile": "tsx --env-file-if-exists=../../.env src/jobs/reconcile.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@copy-trade/application": "workspace:*",
    "@copy-trade/contracts": "workspace:*",
    "@copy-trade/db": "workspace:*",
    "@copy-trade/domain": "workspace:*",
    "@copy-trade/messaging": "workspace:*",
    "@copy-trade/platform": "workspace:*",
    "@fastify/cors": "11.4.3",
    "@fastify/swagger": "9.9.5",
    "@fastify/swagger-ui": "6.1.4",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.2",
    "@opentelemetry/instrumentation": "0.301.2",
    "@opentelemetry/instrumentation-http": "0.301.2",
    "@opentelemetry/instrumentation-pg": "0.78.0",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-node": "0.301.2",
    "close-with-grace": "2.5.0",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "kafkajs": "2.2.4",
    "kysely": "0.29.9",
    "openapi-types": "12.1.3",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "prom-client": "15.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "pino-pretty": "13.2.0",
    "tsdown": "0.23.7"
  }
}
