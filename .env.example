# Copy to .env. Every value has a default; nothing here is required for `docker compose up`.

# --- docker compose -----------------------------------------------------------
POSTGRES_USER=copytrade
POSTGRES_PASSWORD=copytrade
POSTGRES_DB=copytrade
POSTGRES_PORT=5432
# API_PORT is the nginx load balancer in front of the API replicas.
API_PORT=3000
WEB_PORT=8080
CONSOLE_PORT=8090
KAFKA_EXTERNAL_PORT=19092
API_REPLICAS=3
WORKER_REPLICAS=3
# Demo knob: per-message delay in the workers so lag, rebalances and kills are visible.
WORKER_SIMULATED_LATENCY_MS=0

# --- local development (pnpm dev / pnpm db:migrate against the compose Postgres) ---
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://copytrade:copytrade@127.0.0.1:5432/copytrade
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=5000
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:8080
LIST_LIMIT=200
TX_MAX_ATTEMPTS=5
TX_RETRY_BASE_DELAY_MS=10
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=3
OUTBOX_RETRY_DELAY_MS=2000
RECONCILIATION_INTERVAL_MS=30000
STUCK_PENDING_THRESHOLD_MS=60000
# Trades whose id starts with this prefix are rejected by the simulated broker (compensation demo).
SIMULATED_FAILURE_TRADE_PREFIX=fail-
HEARTBEAT_INTERVAL_MS=2000
# Event bus (optional for the API: without KAFKA_BROKERS trades are stored but not published).
KAFKA_BROKERS=127.0.0.1:19092
KAFKA_REQUESTED_PARTITIONS=6
EVENT_RELAY_INTERVAL_MS=200
EVENT_RELAY_BATCH_SIZE=100
EVENT_RELAY_RETRY_DELAY_MS=1000
CONSOLE_URL=http://localhost:8090

# --- worker (apps/worker, pnpm --filter @copy-trade/worker dev) ---------------
# CONSUMER_GROUP=copy-trade-workers
# KAFKA_SESSION_TIMEOUT_MS=10000
# KAFKA_HEARTBEAT_INTERVAL_MS=1000
# WORKER_CONCURRENCY=3
# WORKER_MAX_ATTEMPTS=3
# WORKER_RETRY_DELAY_MS=500
# METRICS_PORT=9100
# LAG_INTERVAL_MS=2000
OTEL_SERVICE_NAME=copy-trade-api
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
