{
  "name": "copy-trade",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @copy-trade/api --filter @copy-trade/worker --filter @copy-trade/web dev",
    "build": "pnpm -r build",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @copy-trade/api migrate",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --parallel typecheck",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --project unit --coverage",
    "test:e2e": "playwright test --project e2e",
    "test:mutation": "stryker run",
    "reconcile": "pnpm --filter @copy-trade/api reconcile",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm test:integration && pnpm test:e2e:stack",
    "stack:up": "docker compose up -d --build --wait",
    "stack:down": "docker compose down",
    "test:e2e:stack": "pnpm stack:up && pnpm test:e2e",
    "demo:record": "playwright test --project demo",
    "load": "tsx scripts/load.ts"
  },
  "devDependencies": {
    "@copy-trade/contracts": "workspace:*",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@testcontainers/postgresql": "12.2.1",
    "@testcontainers/redpanda": "12.2.1",
    "@types/autocannon": "7.12.7",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "autocannon": "9.0.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  }
}
